# Copy to .env and fill in. NEVER commit the real .env.
# .htaccess denies web access to this file; keep it outside the web root if you can.

# XE Currency Data API (https://www.xe.com/xecurrencydata/) — account-based, Basic auth.
XE_ACCOUNT_ID=
XE_API_KEY=
XE_API_BASE=https://xecdapi.xe.com/v1

# Allow ONE blocking API refresh during a page request when the cache is stale.
# Leave at 0 in production and refresh via cron instead, so visitors never wait
# on the API:  */30 * * * * /usr/bin/php /path/to/tools/refresh-currency.php
CURRENCY_REFRESH_ON_REQUEST=0

# ---------------------------------------------------------------------
# Social sign-in (OAuth 2.0). Each provider needs an app created in its own
# developer console. Register this EXACT redirect URI for each:
#
#   Google    https://www.convercession.com/auth/callback/google
#   Facebook  https://www.convercession.com/auth/callback/facebook
#   X         https://www.convercession.com/auth/callback/x
#
# A provider with no credentials shows as "Not configured" on /login rather
# than sending people into a broken redirect. Leave a pair blank to keep that
# provider switched off.
# ---------------------------------------------------------------------

# https://console.cloud.google.com/apis/credentials -> OAuth client ID -> Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# https://developers.facebook.com/apps -> Facebook Login -> Settings
# The app must be Live, and "Valid OAuth Redirect URIs" must list the URI above.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# https://developer.x.com/en/portal/dashboard -> your project -> User authentication settings
# Type: Web App. X requires PKCE (already implemented) and does NOT return an
# email address on this tier — see /login for how that is handled.
X_CLIENT_ID=
X_CLIENT_SECRET=
