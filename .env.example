# Copy to .env and fill in real values when wiring up these integrations.
# Never commit the real .env file or hard-code these values in source.

# Database (when migrating off the embedded SQLite file in includes/db.php)
DATABASE_URL=

# Transactional email on new enquiries / CRM notifications
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=hello@videshia.com

# WhatsApp Business API for enquiry confirmations and consultant follow-ups
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# SMS OTP / notifications
SMS_API_KEY=

# Analytics
GOOGLE_ANALYTICS_ID=
GOOGLE_SEARCH_CONSOLE_VERIFICATION=
