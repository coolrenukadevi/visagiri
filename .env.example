APP_ENV=production
APP_DEBUG=false
APP_URL=https://visagiri.com

SESSION_SECURE_COOKIE=true

MAIL_FROM_NAME="Visagiri Website"
MAIL_FROM_ADDRESS=info@visagiri.com
MAIL_ENQUIRY_RECIPIENTS="info@visagiri.com,accounts@visagiri.com"

# Google Apps Script Web App URL for the /contact/ form — see
# docs/google-sheets-setup.md. Leave blank until you've deployed the
# script; enquiries fall back to email-only until then.
GOOGLE_APPS_SCRIPT_URL=
