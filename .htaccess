# =====================================================================
# Convercession — clean URLs, canonical host, security
#
# Ordering matters. The EXTERNAL redirects (what the browser sees) must run
# before the INTERNAL rewrites (what PHP sees), and every internal rewrite
# ends in [L] so it can't fall through and re-trigger a redirect — that is
# how .php-hiding setups usually end up in an infinite loop.
# =====================================================================

Options -Indexes +FollowSymLinks
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
RewriteEngine On
# RewriteBase /

# ---------------------------------------------------------------
# 0. Never touch real files that should be served as-is
#    (css/js/images/sitemap/robots). Placed first so nothing below
#    can accidentally rewrite an asset.
# ---------------------------------------------------------------
# `data/` is NOT listed: nothing in the browser fetches it (PHP reads those
# files off disk), so it is blocked with the other server-side internals below.
RewriteRule ^(css|js|assets|images)/ - [L]
# sitemap*.xml is deliberately NOT passed through to the filesystem here — it
# is generated by sitemap.php (step 6). A stale static sitemap.xml on disk
# would otherwise win this rule and keep advertising dead URLs to crawlers.
RewriteRule ^(robots\.txt|favicon\.ico)$ - [L]

# ---------------------------------------------------------------
# 1. Block direct access to server-side internals. These would never
#    resolve to a page anyway, but a 403 is better than a stack trace.
# ---------------------------------------------------------------
RewriteRule ^(includes|lib-php|lib|cache|tools|data|node_modules)/ - [F,L]
RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|DEVELOPMENT\.md|REDIRECT-MAP\.md) - [F,L]

# ---------------------------------------------------------------
# 2. Canonical origin: force HTTPS + the www host, in ONE redirect
#    (chaining two 301s costs link equity and trips "redirect chain"
#    audits). HTTP_HOST test is skipped when already correct.
# ---------------------------------------------------------------
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.convercession\.com$ [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$
RewriteRule ^ https://www.convercession.com%{REQUEST_URI} [R=301,L,NE]

# ---------------------------------------------------------------
# 3. EXTERNAL: strip ".php" from any URL a visitor/crawler requests.
#    THE_REQUEST is used (not REQUEST_URI) so this only fires for a
#    genuine browser request, never for our own internal rewrite in
#    step 6 — that distinction is what prevents the redirect loop.
# ---------------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE,QSA]

# ---------------------------------------------------------------
# 4. EXTERNAL: /index -> / (one canonical homepage URL)
# ---------------------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+index(\.php)?[\s?] [NC]
RewriteRule ^ / [R=301,L,NE,QSA]

# ---------------------------------------------------------------
# 5. EXTERNAL: enforce no-trailing-slash (except root), so /countries/
#    and /countries are not two indexable URLs.
# ---------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L,NE,QSA]

# ---------------------------------------------------------------
# 6. INTERNAL: pretty URL -> real PHP file. Nothing below is visible
#    to the user; each rule is [L] so it terminates here.
# ---------------------------------------------------------------

# Legacy .html URLs from the previous static build -> clean equivalents.
RewriteRule ^visa/([a-z0-9-]+)\.html$ /visa/$1 [R=301,L,NE]
RewriteRule ^countries\.html$ /countries [R=301,L,NE]
RewriteRule ^payments\.html$ /payments [R=301,L,NE]
RewriteRule ^index\.html$ / [R=301,L,NE]

# Sign-in. /auth/callback/{provider} must be matched BEFORE /auth/{provider},
# or "callback" would be read as the provider name.
RewriteRule ^auth/callback/(google|facebook|x)/?$ /auth.php?action=callback&provider=$1 [L,QSA]
RewriteRule ^auth/(google|facebook|x)/?$ /auth.php?action=start&provider=$1 [L,QSA]
RewriteRule ^logout/?$ /auth.php?action=logout [L,QSA]

# Visa CATEGORY pages must be matched BEFORE the country rule, otherwise
# /visa/tourist would be looked up as a country slug and 404.
RewriteRule ^visa/request-info/?$ /request-info.php [L,QSA]
RewriteRule ^visa/(tourist|business|student|employment|family-dependent|transit|medical|conference|official-diplomatic|renewal|schengen)/?$ /visa-type.php?type=$1 [L,QSA]
# Country guide: /visa/kenya -> visa.php?country=kenya
RewriteRule ^visa/([a-z0-9-]+)/?$ /visa.php?country=$1 [L,QSA]

# Content pages (about, legal, resources, global mobility …) -> page.php
RewriteRule ^(about|contact|visa-finder|track-visa|application-management|document-verification|visa-status-tracking|appointment-management|technology|ai-visa-assistant|global-mobility|corporate-visa-management|group-visa-management|employee-immigration|business-travel-compliance|embassies|visa-requirements|visa-fees|processing-times|visa-guides|visa-rejection-guide|travel-advisories|visa-news|visa-faqs|leadership|partners|global-network|careers|privacy-policy|terms|refund-policy|cookie-policy|disclaimer|service-agreement|accessibility)/?$ /page.php?p=$1 [L,QSA]

# Sitemaps are generated by PHP but served at .xml addresses.
RewriteRule ^sitemap\.xml$ /sitemap.php [L]
RewriteRule ^sitemap-([a-z]+)\.xml$ /sitemap.php?set=$1 [L]

# Generic: /about -> about.php (only when that PHP file actually exists,
# so a typo 404s properly instead of silently serving something else).
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ /$1.php [L,QSA]
ErrorDocument 404 /404.php
</IfModule>

# ---------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # HSTS: enable once HTTPS is confirmed working on all subdomains.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ---------------------------------------------------------------
# Caching / compression (Core Web Vitals)
# ---------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Belt-and-braces: even if mod_rewrite is off, never serve these.
<FilesMatch "^(\.env|.*\.json|.*\.md)$">
  Require all denied
</FilesMatch>
<Files ~ "\.(log|tmp)$">
  Require all denied
</Files>
