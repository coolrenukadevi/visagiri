# Visa Agency — clean URLs (no .php in public URLs)
Options -MultiViews
RewriteEngine On
RewriteBase /

# Redirect direct *.php requests to their clean equivalent (except mail-handler.php,
# which is a form-submission endpoint, not a browsable page).
RewriteCond %{THE_REQUEST} \s/+([a-zA-Z0-9_-]+)\.php[\s?] [NC]
RewriteCond %1 !^mail-handler$ [NC]
RewriteCond %1 !^enquiry-handler$ [NC]
RewriteCond %1 !^newsletter-subscribe$ [NC]
RewriteCond %1 !^quick-enquiry-handler$ [NC]
RewriteCond %1 !^analytics-event$ [NC]
RewriteCond %1 !^b2b-otp-send$ [NC]
RewriteCond %1 !^b2b-otp-verify$ [NC]
RewriteCond %1 !^b2b-partner-register-handler$ [NC]
RewriteCond %1 !^b2b-document-upload$ [NC]
RewriteCond %1 !^b2b-login-handler$ [NC]
RewriteCond %1 !^b2b-reset-password$ [NC]
RewriteCond %1 !^b2b-new-application-handler$ [NC]
RewriteCond %1 !^index$ [NC]
RewriteRule ^ /%1 [R=301,L]

# Redirect /index to /
RewriteCond %{THE_REQUEST} \s/+index(?:\.php)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# Serve index.php for the homepage
RewriteRule ^$ index.php [L]

# Dynamically-generated XML sitemap, always in sync with the countries/
# content-pages database instead of a stale hand-maintained file.
RewriteRule ^sitemap\.xml$ sitemap-xml.php [L]

# Country x visa-purpose SEO pages: /countries/{slug}/ and
# /countries/{country-slug}-{category-slug}/ both dispatch to countries.php,
# which resolves the slug against the DB and renders the hub or content page.
RewriteRule ^countries/([a-z0-9-]+)/?$ countries.php?slug=$1 [L,QSA]

# Map a clean URL to its .php file when the file exists and no real
# file/directory already matches the request.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [L]

# 404 fallback
ErrorDocument 404 /404.php

# Never allow mail-handler.php / enquiry-handler.php to be listed/browsed
# directly via GET from the address bar — they are POST-only endpoints.
# (Uses mod_rewrite, already required above, rather than <If>/mod_version —
# some hosts don't have mod_version enabled, and an unsupported directive in
# .htaccess causes a 500 Internal Server Error for every request on the site.)
RewriteCond %{REQUEST_METHOD} =GET
RewriteRule ^(mail-handler|enquiry-handler|newsletter-subscribe|quick-enquiry-handler|analytics-event|b2b-otp-send|b2b-otp-verify|b2b-partner-register-handler|b2b-document-upload|b2b-login-handler|b2b-reset-password|b2b-new-application-handler)\.php$ - [F,L]
