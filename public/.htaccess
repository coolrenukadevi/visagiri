# Never let Apache fall back to a raw directory listing (e.g. if this
# document root is ever pointed at by mistake with no matching
# DirectoryIndex, or a subfolder has no index file) — config/,
# database/, includes/ etc. must never be browsable even as a listing.
Options -Indexes

RewriteEngine On

# Force HTTPS (matches the redirect the legacy site already relied on).
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-SSL} !on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# includes/, config/, and storage/ must never be reached by a direct
# web request — includes/ and config/ (which holds the real database
# password, see config/database.php) are only ever `require`d from
# PHP, never via a URL, and storage/ is just local rate-limiter
# fallback state. In the standard two-folder layout (this file lives
# in public/, those are siblings one level up, so a browser can never
# reach them regardless), this rule is a harmless no-op; in the
# flattened single-folder cPanel package (bin/package-cpanel.sh), it's
# the only thing standing between a stray request and the database
# credentials — so it's kept here rather than only in the packaged copy.
RewriteRule ^(includes|config|storage)(/.*)?$ - [F,L]

# Serve real static files (CSS/JS/images) as-is. Deliberately excludes
# .php: a request that happens to resolve to a real .php file (e.g.
# attestation/index.php, only reachable at all in the flattened
# layout) must still fall through to the front controller below rather
# than being executed directly by Apache with none of index.php's
# routing/session/security setup having run. Also deliberately does
# NOT bypass on `-d` (a real directory) for the same reason — the
# flattened layout has real PHP-holding directories (attestation/,
# visa/, dashboard/, ...) sitting right next to this file.
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_FILENAME} !\.php$
RewriteRule ^ - [L]

# Everything else goes through the front controller.
RewriteRule ^ index.php [L]

# Never serve dotfiles (.env, .git, etc.) even if they end up under /public.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Browser caching for static assets. Wrapped in <IfModule> so a host
# without mod_expires just skips this block instead of a 500 from an
# unrecognized directive — PHP responses (everything routed through
# index.php above) are untouched by this, only real static files.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpe?g|svg|webp|gif|ico|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Compress text-based responses (HTML from PHP included).
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>
