# Secrets — never commit. Copy .env.example to .env and fill it in on the server.
.env

# Runtime cache (FX rates). Regenerated by tools/refresh-currency.php.
cache/*.json

# User database (accounts + linked identities). Real user data — never commit,
# and back it up separately from the code.
cache/*.sqlite
cache/*.sqlite-wal
cache/*.sqlite-shm

# Uploaded customer documents (passports, bank statements, ...). Real user
# data with its own retention/backup policy — never commit.
cache/documents/

node_modules/
*.log
*.tmp
